    {
      "@type": "FAQPage",
      "@id": "https://www.arrayhelper.com/#faq",
      "url": "https://www.arrayhelper.com/#faq",
      "name": "Text list to array: frequently asked questions",
      "inLanguage": "en",
      "isPartOf": {
        "@id": "https://www.arrayhelper.com/#webpage"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is a text list to array converter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is a tool that turns a plain list of values, one per line, into an array literal you can paste straight into code. ArrayHelper builds the JavaScript, SQL, Python, PHP, JSON, C# and custom versions of the same list at once, so you never hand-type quotes and commas again."
          }
        },
        {
          "@type": "Question",
          "name": "How do I convert a text list to an array online?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Paste the list into the editor at the top of this page, press Ctrl / Cmd + Enter or leave Auto Run on, then copy the panel you need. Nothing to install, no sign-up and no row limit."
          }
        },
        {
          "@type": "Question",
          "name": "Does it escape quotes and special characters?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Single quotes are doubled for SQL, and the JSON and C# outputs use real JSON string escaping, so values with apostrophes, backslashes or tabs stay valid in the target language."
          }
        },
        {
          "@type": "Question",
          "name": "Are numbers quoted?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not by default — plain numeric lines are written as numbers and everything else is quoted. If your column is a string type, the numbers toggle in the toolbar quotes them too."
          }
        },
        {
          "@type": "Question",
          "name": "Can I remove duplicate lines while converting?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Switch on Dedupe in the options menu and only the first occurrence of each line is kept. Blank lines and surrounding whitespace are always trimmed, with or without Dedupe."
          }
        },
        {
          "@type": "Question",
          "name": "How large a list can it handle?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The classic editor is comfortable up to 50,000 lines, and the Ultra editor keeps even larger pastes responsive. Long outputs are shortened on screen for speed, but Copy always gives you the complete array."
          }
        },
        {
          "@type": "Question",
          "name": "Is my list uploaded to a server?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Every conversion runs locally in your browser, so your list never leaves your device — which is why the tool is safe for internal identifiers and customer data."
          }
        },
        {
          "@type": "Question",
          "name": "Can I define my own output format?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The Custom panel takes a template like EXEC MyProcedure '{}';, where {} is the line value, {n} the row number starting at 1 and {i} the index starting at 0. Every line is rendered with that template on its own row."
          }
        },
        {
          "@type": "Question",
          "name": "Which SQL dialect does the IN clause use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Both. N'...' is the default for SQL Server; switch the SQL setting to '...' for MySQL, PostgreSQL, SQLite and other standard dialects."
          }
        }
      ]
    }
  ]
